# Copy to .env.local and fill in. Restart `npm run dev` after changing.

# --- Supabase (dashboard project — Settings → API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Prefer the new publishable key (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy anon key — optional fallback if your project still uses it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Access control ----------------------------------------------------------
# The REAL lock: only these emails (comma-separated, lowercased) get in.
ALLOWED_EMAILS=robgreen31@gmail.com

# --- Disk sync (local `npm run sync` only — scripts/sync-from-disk.mjs) --------
# Server-only SECRET. Never prefix with NEXT_PUBLIC_ and never deploy to Vercel.
# Supabase → Settings → API → "service_role" secret (starts with sb_secret_ / eyJ...).
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Optional overrides (defaults shown):
# SYNC_USER_EMAIL=robgreen31@gmail.com
# SYNC_CODE_ROOT=C:\Users\Rob\Documents\Claude\Code
# SYNC_IGNORE=Green Phoenix         # comma-separated folder names to skip
# SYNC_JOBHUNTER_DIR=C:\Users\Rob\Documents\Claude\Code\Job Hunter   # holds jobs/jobs.json
